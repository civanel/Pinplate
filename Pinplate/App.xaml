<Application x:Class="Pinplate.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:converters="clr-namespace:Pinplate.Converters">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Resources/Styles/Colors.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <converters:StatusToColorConverter x:Key="StatusToColor"/>
            <converters:BoolToVisibilityConverter x:Key="BoolToVisibility"/>
            <converters:PointsConverter x:Key="PointsConverter"/>
            <converters:PercentToWidthConverter x:Key="PercentToWidth"/>
        </ResourceDictionary>
    </Application.Resources>
</Application>