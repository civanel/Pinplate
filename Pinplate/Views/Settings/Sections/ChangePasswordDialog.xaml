<Window x:Class="Pinplate.Views.Settings.Sections.ChangePasswordDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Смена пароля"
        Width="420" Height="440"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="White"
        WindowStyle="None"
        AllowsTransparency="True">

    <Border CornerRadius="12" Background="White" Margin="20">
        <Border.Effect>
            <DropShadowEffect Color="#444" BlurRadius="20" ShadowDepth="0" Opacity="0.3"/>
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Margin="25,20,25,10">
                <TextBlock Text="Смена пароля" FontSize="16" FontWeight="Bold"
                           Foreground="{StaticResource TextPrimaryBrush}"/>
                <TextBlock Text="✕" FontSize="16"
                           Foreground="{StaticResource TextSecondaryBrush}"
                           HorizontalAlignment="Right" Cursor="Hand"
                           MouseLeftButtonUp="Close_Click"/>
            </Grid>

            <StackPanel Grid.Row="1" Margin="25,10">
                <TextBlock Text="Текущий пароль" FontSize="12"
                           Foreground="{StaticResource TextSecondaryBrush}"
                           Margin="0,0,0,5"/>
                <PasswordBox x:Name="CurrentPassword" Height="40" Padding="12,0"
                             VerticalContentAlignment="Center"
                             Background="#F5EDE8" BorderThickness="0"
                             Margin="0,0,0,15"/>

                <TextBlock Text="Новый пароль" FontSize="12"
                           Foreground="{StaticResource TextSecondaryBrush}"
                           Margin="0,0,0,5"/>
                <PasswordBox x:Name="NewPassword" Height="40" Padding="12,0"
                             VerticalContentAlignment="Center"
                             Background="#F5EDE8" BorderThickness="0"
                             Margin="0,0,0,5"/>

                <ProgressBar x:Name="StrengthBar" Height="6" Minimum="0" Maximum="100"
                             Value="0" Foreground="{StaticResource AccentGreenBrush}"
                             Background="#EFE6E0" BorderThickness="0"
                             Margin="0,0,0,12"/>
                <TextBlock x:Name="StrengthText" Text="Надёжность: (от 8-12 символов)"
                           FontSize="11"
                           Foreground="{StaticResource TextSecondaryBrush}"
                           Margin="0,0,0,15"/>

                <TextBlock Text="Повторите новый пароль" FontSize="12"
                           Foreground="{StaticResource TextSecondaryBrush}"
                           Margin="0,0,0,5"/>
                <PasswordBox x:Name="ConfirmPassword" Height="40" Padding="12,0"
                             VerticalContentAlignment="Center"
                             Background="#F5EDE8" BorderThickness="0"/>
            </StackPanel>

            <Grid Grid.Row="2" Margin="25,10,25,20">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Button Grid.Column="1" Content="Отмена"
                        Background="Transparent"
                        Foreground="{StaticResource TextPrimaryBrush}"
                        BorderBrush="#DDDDDD" BorderThickness="1"
                        Padding="25,10" Cursor="Hand"
                        Click="Close_Click" Style="{StaticResource SmallButtonStyle}"/>
                <Button Grid.Column="2" Content="Сохранить"
                        Background="{StaticResource AccentPinkBrush}"
                        Foreground="White" BorderThickness="0"
                        Padding="25,10" Margin="8,0,0,0" Cursor="Hand"
                        Click="Save_Click" Style="{StaticResource SmallButtonStyle}"/>
            </Grid>
        </Grid>
    </Border>
</Window>