<UserControl x:Class="Pinplate.Views.Settings.Sections.ExpertProfileSection"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:Pinplate.ViewModels.Settings"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignHeight="400" d:DesignWidth="600">

    <UserControl.DataContext>
        <vm:ExpertProfileSectionViewModel/>
    </UserControl.DataContext>

    <Border Style="{StaticResource CardStyle}" VerticalAlignment="Top">
        <StackPanel>
            <TextBlock Text="Профиль"
                       FontSize="16" FontWeight="Bold"
                       Foreground="{StaticResource TextPrimaryBrush}"
                       Margin="0,0,0,20"/>

            <StackPanel Orientation="Horizontal" Margin="0,0,0,20">
                <Ellipse Width="60" Height="60" Fill="#D68C8C"/>
                <Button Content="Сменить фото"
                        Background="Transparent"
                        Foreground="{StaticResource TextPrimaryBrush}"
                        BorderBrush="#DDDDDD"
                        BorderThickness="1"
                        Padding="15,8"
                        Margin="15,0,0,0"
                        VerticalAlignment="Center"
                        Cursor="Hand"
                        Command="{Binding ChangePhotoCommand}" Style="{StaticResource SmallButtonStyle}"/>
            </StackPanel>

            <TextBlock Text="Имя" Foreground="{StaticResource TextPrimaryBrush}"
                       FontSize="12" Margin="0,0,0,5"/>
            <TextBox Text="{Binding UserName, UpdateSourceTrigger=PropertyChanged}"
                     Padding="10,8" Margin="0,0,0,15"
                     Background="#F5EDE8" BorderThickness="0"/>

            <TextBlock Text="Email" Foreground="{StaticResource TextPrimaryBrush}"
                       FontSize="12" Margin="0,0,0,5"/>
            <TextBox Text="{Binding Email, UpdateSourceTrigger=PropertyChanged}"
                     Padding="10,8" Margin="0,0,0,20"
                     Background="#F5EDE8" BorderThickness="0"/>

            <Button Content="Сохранить"
                    HorizontalAlignment="Right"
                    Background="{StaticResource AccentPinkBrush}"
                    Foreground="White"
                    BorderThickness="0"
                    Padding="25,10"
                    Cursor="Hand"
                    Command="{Binding SaveCommand}" Style="{StaticResource SmallButtonStyle}"/>
        </StackPanel>
    </Border>
</UserControl>