<UserControl x:Class="Pinplate.Views.Settings.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:Pinplate.ViewModels.Settings"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignHeight="600" d:DesignWidth="900">

    <UserControl.DataContext>
        <vm:SettingsViewModel/>
    </UserControl.DataContext>

    <StackPanel>
        <TextBlock Text="Настройки"
                   FontSize="24" FontWeight="Bold"
                   Foreground="{StaticResource TextPrimaryBrush}"
                   Margin="0,0,0,20"/>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="250"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- ЛЕВОЕ МЕНЮ РАЗДЕЛОВ -->
            <Border Grid.Column="0"
                    Background="{StaticResource CardBrush}"
                    CornerRadius="12" Padding="10"
                    Margin="0,0,15,0"
                    VerticalAlignment="Top">
                <StackPanel>
                    <Button Content="Безопасность"
                            Tag="Security"
                            Command="{Binding NavigateCommand}"
                            CommandParameter="{Binding Tag, RelativeSource={RelativeSource Self}}">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource SettingsMenuButtonStyle}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding ActiveSection}" Value="Security">
                                        <Setter Property="Background" Value="#F2D5D5"/>
                                        <Setter Property="Foreground" Value="{StaticResource AccentPinkBrush}"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>

                    <Button Content="Уведомления"
                            Tag="Notifications"
                            Command="{Binding NavigateCommand}"
                            CommandParameter="{Binding Tag, RelativeSource={RelativeSource Self}}">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource SettingsMenuButtonStyle}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding ActiveSection}" Value="Notifications">
                                        <Setter Property="Background" Value="#F2D5D5"/>
                                        <Setter Property="Foreground" Value="{StaticResource AccentPinkBrush}"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>

                    <Button Content="Внешний вид"
                            Tag="Appearance"
                            Command="{Binding NavigateCommand}"
                            CommandParameter="{Binding Tag, RelativeSource={RelativeSource Self}}">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource SettingsMenuButtonStyle}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding ActiveSection}" Value="Appearance">
                                        <Setter Property="Background" Value="#F2D5D5"/>
                                        <Setter Property="Foreground" Value="{StaticResource AccentPinkBrush}"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>

                    <Button Content="Профиль"
                            Tag="Profile"
                            Command="{Binding NavigateCommand}"
                            CommandParameter="{Binding Tag, RelativeSource={RelativeSource Self}}">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource SettingsMenuButtonStyle}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding ActiveSection}" Value="Profile">
                                        <Setter Property="Background" Value="#F2D5D5"/>
                                        <Setter Property="Foreground" Value="{StaticResource AccentPinkBrush}"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                </StackPanel>
            </Border>

            <!-- ПРАВАЯ ЧАСТЬ -->
            <ContentControl Grid.Column="1"
                            Content="{Binding CurrentSection}"/>
        </Grid>
    </StackPanel>
</UserControl>