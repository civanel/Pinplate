<UserControl x:Class="Pinplate.Views.Expert.TopView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:Pinplate.ViewModels.Expert"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignHeight="700" d:DesignWidth="900">

    <UserControl.DataContext>
        <vm:ExpertTopViewModel/>
    </UserControl.DataContext>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel>
            <TextBlock Text="Топ-лента"
                       FontSize="24" FontWeight="Bold"
                       Foreground="{StaticResource TextPrimaryBrush}"
                       Margin="0,0,0,20"/>

            <Border Style="{StaticResource CardStyle}" Padding="15" Margin="0,0,0,15">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <ComboBox Grid.Column="0" Width="120" Margin="0,0,10,0" 
                              SelectedValue="{Binding SelectedFilter}" SelectedValuePath="Content">
                        <ComboBoxItem Content="Все" IsSelected="True"/>
                        <ComboBoxItem Content="В топе"/>
                    </ComboBox>

                    <ComboBox Grid.Column="1" Width="140" 
                              SelectedValue="{Binding SelectedSort}" SelectedValuePath="Content">
                        <ComboBoxItem Content="По дате" IsSelected="True"/>
                        <ComboBoxItem Content="По рейтингу"/>
                    </ComboBox>

                    <TextBlock Grid.Column="3" Text="Сбросить"
                               Foreground="{StaticResource AccentPinkBrush}"
                               FontSize="12" Cursor="Hand" VerticalAlignment="Center">
                        <TextBlock.InputBindings>
                            <MouseBinding Gesture="LeftClick" Command="{Binding ResetCommand}"/>
                        </TextBlock.InputBindings>
                    </TextBlock>
                </Grid>
            </Border>

            <ItemsControl ItemsSource="{Binding Recipes}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{StaticResource CardStyle}" Padding="15" Margin="0,0,0,10">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <Border Grid.Column="0" Width="60" Height="60"
                                        Background="#EFE6E0" CornerRadius="8"
                                        VerticalAlignment="Center"/>

                                <StackPanel Grid.Column="1" Margin="15,0,0,0" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Title}" FontSize="14" FontWeight="Bold"
                                               Foreground="{StaticResource TextPrimaryBrush}"/>

                                    <TextBlock Text="{Binding Description}" FontSize="12" 
                                               Foreground="{StaticResource TextSecondaryBrush}" 
                                               Margin="0,3,0,0" TextTrimming="CharacterEllipsis"/>

                                    <StackPanel Orientation="Horizontal" Margin="0,3,0,0">
                                        <TextBlock Text="{Binding Author}" FontSize="12"
                                                   Foreground="{StaticResource TextSecondaryBrush}"/>
                                        <TextBlock Text=" • " FontSize="12"
                                                   Foreground="{StaticResource TextSecondaryBrush}"/>
                                        <TextBlock Text="{Binding Category}" FontSize="12"
                                                   Foreground="{StaticResource TextSecondaryBrush}"/>
                                        <TextBlock Text=" • Рейтинг: " FontSize="12"
                                                   Foreground="{StaticResource TextSecondaryBrush}"/>
                                        <TextBlock Text="★" FontSize="12" Foreground="#FFD700" VerticalAlignment="Center" Margin="0,0,2,0"/>
                                        <TextBlock Text="{Binding Rating, StringFormat={}{0:F1}}" FontSize="12" 
                                                   Foreground="{StaticResource TextPrimaryBrush}" FontWeight="Bold" VerticalAlignment="Center"/>
                                    </StackPanel>

                                    <TextBlock Text="{Binding ApprovedDate, StringFormat='Одобрено: {0}'}"
                                               FontSize="11" Margin="0,3,0,0"
                                               Foreground="{StaticResource TextSecondaryBrush}"/>
                                </StackPanel>

                                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">

                                    <Button Content="Просмотр" 
                                            Background="Transparent"
                                            Foreground="{StaticResource TextPrimaryBrush}"
                                            BorderBrush="#DDDDDD" BorderThickness="1"
                                            Padding="15,6" Margin="0,0,10,0" Cursor="Hand"
                                            Click="Recipe_Click"
                                            Style="{StaticResource SmallButtonStyle}"/>

                                    <!-- Кнопка-переключатель -->
                                    <Button Content="В топ"
                                            Background="Transparent"
                                            Foreground="{StaticResource TextPrimaryBrush}"
                                            BorderBrush="#DDDDDD"
                                            BorderThickness="1"
                                            Padding="15,6"
                                            Cursor="Hand"
                                            Command="{Binding DataContext.ToggleTopCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                            CommandParameter="{Binding}">
                                        <Button.Style>
                                            <Style TargetType="Button" BasedOn="{StaticResource SmallButtonStyle}">
                                                <Style.Triggers>
                                                    <!-- Если рецепт в топе -->
                                                    <DataTrigger Binding="{Binding IsTop}" Value="True">
                                                        <Setter Property="Content" Value="Убрать из топа"/>
                                                        <Setter Property="Foreground" Value="{StaticResource AccentPinkBrush}"/>
                                                        <Setter Property="BorderBrush" Value="{StaticResource AccentPinkBrush}"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Button.Style>
                                    </Button>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>
    </ScrollViewer>
</UserControl>