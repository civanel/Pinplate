<Window x:Class="Pinplate.Views.Main.ExpertDashboard"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:Pinplate.ViewModels.Expert"
        xmlns:controls="clr-namespace:Pinplate.Controls"
        Title="Pinplate — Эксперт"
        Height="800" Width="1200"
        MinHeight="600" MinWidth="900"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BackgroundBrush}">

    <Window.DataContext>
        <vm:ExpertDashboardViewModel/>
    </Window.DataContext>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="220"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <controls:ExpertSidebarMenu Grid.Column="0"
                                    NavigateCommand="{Binding NavigateCommand}"
                                    ActiveItem="{Binding ActiveMenuItem}"/>

        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="70"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <controls:TopBar Grid.Row="0"
                             SectionTitle="{Binding CurrentSectionTitle}"/>

            <ContentControl Grid.Row="1"
                            Content="{Binding CurrentView}"
                            Margin="20"/>
        </Grid>
    </Grid>
</Window>