<Window x:Class="Pinplate.Views.Expert.Dialogs.RejectRecipeDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Отклонить рецепт"
        Width="450" Height="480"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="White"
        WindowStyle="None"
        AllowsTransparency="True">

    <Border CornerRadius="12" Background="White" Margin="20">
        <Border.Effect>
            <DropShadowEffect Color="#444" BlurRadius="20" ShadowDepth="0" Opacity="0.3"/>
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Margin="25,20,25,10">
                <TextBlock Text="Отклонить рецепт"
                           FontSize="16" FontWeight="Bold"
                           Foreground="{StaticResource TextPrimaryBrush}"/>
                <!-- КРЕСТИК ТЕПЕРЬ КНОПКА -->
                <Button Content="✕" FontSize="16"
                        Foreground="{StaticResource TextSecondaryBrush}"
                        HorizontalAlignment="Right" Cursor="Hand"
                        Background="Transparent" BorderThickness="0" Padding="0"
                        Click="Close_Click"/>
            </Grid>

            <StackPanel Grid.Row="1" Margin="25,10">
                <TextBlock Text="Паста карбонара — @ivan"
                           FontSize="13"
                           Foreground="{StaticResource TextPrimaryBrush}"
                           Margin="0,0,0,20"/>

                <TextBlock Text="Причина отклонения:"
                           FontSize="12" FontWeight="SemiBold"
                           Foreground="{StaticResource TextPrimaryBrush}"
                           Margin="0,0,0,10"/>

                <RadioButton Content="Неполное описание" GroupName="Reason"
                             Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,8"/>
                <RadioButton Content="Плохое фото" GroupName="Reason"
                             Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,8"/>
                <RadioButton Content="Нарушение правил" GroupName="Reason"
                             Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,8"/>
                <RadioButton x:Name="OtherRadio" Content="Другое:"
                             GroupName="Reason" Foreground="{StaticResource TextPrimaryBrush}"
                             Margin="0,0,0,8" Checked="OtherRadio_Checked"/>

                <TextBox x:Name="OtherReasonBox"
                         Padding="10,8"
                         Background="#F5EDE8"
                         BorderThickness="0"
                         Margin="20,0,0,0"
                         Height="80"
                         TextWrapping="Wrap"
                         VerticalContentAlignment="Top"
                         IsEnabled="False"/>
            </StackPanel>

            <Grid Grid.Row="2" Margin="25,10,25,20">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- ОТМЕНА ТОЖЕ ВЫЗЫВАЕТ Close_Click -->
                <Button Grid.Column="1" Content="Отмена"
                        Background="Transparent"
                        Foreground="{StaticResource TextPrimaryBrush}"
                        BorderBrush="#DDDDDD"
                        BorderThickness="1"
                        Padding="25,10"
                        Cursor="Hand"
                        Click="Close_Click"/>
                <Button Grid.Column="2" Content="Отклонить"
                        Background="{StaticResource AccentPinkBrush}"
                        Foreground="White"
                        BorderThickness="0"
                        Padding="25,10"
                        Margin="8,0,0,0"
                        Cursor="Hand"
                        Click="Reject_Click"/>
            </Grid>
        </Grid>
    </Border>
</Window>