<Window x:Class="Pinplate.Views.Expert.Dialogs.RecipeDetailsDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Рецепт"
        Width="500" Height="600"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="White"
        WindowStyle="None"
        AllowsTransparency="True">

    <Border CornerRadius="12" Background="White" Padding="0">
        <Border.Effect>
            <DropShadowEffect Color="#444" BlurRadius="20" ShadowDepth="0" Opacity="0.3"/>
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Шапка -->
            <Grid Grid.Row="0" Margin="25,20,25,10">
                <TextBlock Text="Рецепт #4521"
                           FontSize="16" FontWeight="Bold"
                           Foreground="{StaticResource TextPrimaryBrush}"/>
                <TextBlock Text="✕"
                           FontSize="16"
                           Foreground="{StaticResource TextSecondaryBrush}"
                           HorizontalAlignment="Right"
                           Cursor="Hand"
                           MouseLeftButtonUp="Close_Click"/>
            </Grid>

            <!-- Контент -->
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="25,10">
                <StackPanel>
                    <!-- Фото + название -->
                    <Grid Margin="0,0,0,20">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Border Grid.Column="0" Width="100" Height="100"
                                Background="#EFE6E0" CornerRadius="8"/>
                        <StackPanel Grid.Column="1" Margin="15,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="Паста карбонара"
                                       FontSize="15" FontWeight="Bold"
                                       Foreground="{StaticResource TextPrimaryBrush}"/>
                            <TextBlock Text="@ivan" FontSize="12"
                                       Foreground="{StaticResource TextSecondaryBrush}"
                                       Margin="0,3,0,0"/>
                            <TextBlock Text="Основное" FontSize="12"
                                       Foreground="{StaticResource TextSecondaryBrush}"
                                       Margin="0,3,0,0"/>
                        </StackPanel>
                    </Grid>

                    <TextBlock Text="Ингредиенты:" FontWeight="Bold" FontSize="13"
                               Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,8"/>
                    <TextBlock Text="• Спагетти — 400 г" FontSize="12"
                               Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,3"/>
                    <TextBlock Text="• Гуанчале — 150 г" FontSize="12"
                               Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,3"/>
                    <TextBlock Text="• Яйца — 4 шт" FontSize="12"
                               Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,15"/>

                    <TextBlock Text="Описание:" FontWeight="Bold" FontSize="13"
                               Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,8"/>
                    <TextBlock Text="1. Отварить спагетти..." FontSize="12"
                               Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,3"/>
                    <TextBlock Text="2. Обжарить гуанчале..." FontSize="12"
                               Foreground="{StaticResource TextPrimaryBrush}"/>
                </StackPanel>
            </ScrollViewer>

            <!-- Кнопки -->
            <Grid Grid.Row="2" Margin="25,10,25,20">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Button Grid.Column="1" Content="Одобрить"
                        Background="{StaticResource AccentPinkBrush}"
                        Foreground="White"
                        BorderThickness="0"
                        Padding="25,10"
                        Cursor="Hand"
                        Click="Approve_Click" Style="{StaticResource SmallButtonStyle}"/>
                <Button Grid.Column="2" Content="Отмена"
                        Background="Transparent"
                        Foreground="{StaticResource TextPrimaryBrush}"
                        BorderBrush="#DDDDDD"
                        BorderThickness="1"
                        Padding="25,10"
                        Margin="8,0,0,0"
                        Cursor="Hand"
                        Click="Close_Click" Style="{StaticResource SmallButtonStyle}"/>
            </Grid>
        </Grid>
    </Border>
</Window>