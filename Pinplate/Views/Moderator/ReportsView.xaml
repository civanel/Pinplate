<UserControl x:Class="Pinplate.Views.Moderator.ReportsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:Pinplate.ViewModels"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignHeight="700" d:DesignWidth="900">

    <UserControl.DataContext>
        <vm:ReportsViewModel/>
    </UserControl.DataContext>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel>
            <TextBlock Text="Жалобы"
                       FontSize="24" FontWeight="Bold"
                       Foreground="{StaticResource TextPrimaryBrush}"
                       Margin="0,0,0,20"/>

            <!-- Панель фильтров -->
            <Border Style="{StaticResource CardStyle}" Padding="15" Margin="0,0,0,15">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <ComboBox Grid.Column="0" Width="140" Margin="0,0,10,0"
                              SelectedValue="{Binding SelectedFilter}" SelectedValuePath="Content">
                        <ComboBoxItem Content="Открыта"/>
                        <ComboBoxItem Content="В работе"/>
                        <ComboBoxItem Content="Решено"/>
                    </ComboBox>

                    <ComboBox Grid.Column="1" Width="110" Margin="0,0,10,0"
                              SelectedValue="{Binding SelectedType}" SelectedValuePath="Content">
                        <ComboBoxItem Content="Все"/>
                        <ComboBoxItem Content="Спам"/>
                        <ComboBoxItem Content="Мат"/>
                    </ComboBox>

                    <ComboBox Grid.Column="2" Width="130"
                              SelectedValue="{Binding SelectedPeriod}" SelectedValuePath="Content">
                        <ComboBoxItem Content="По дате"/>
                        <ComboBoxItem Content="По времени"/>
                    </ComboBox>

                    <TextBlock Grid.Column="4" Text="Сбросить"
                               Foreground="{StaticResource AccentPinkBrush}"
                               FontSize="12" Cursor="Hand"
                               VerticalAlignment="Center">
                        <TextBlock.InputBindings>
                            <MouseBinding Gesture="LeftClick" Command="{Binding ResetCommand}"/>
                        </TextBlock.InputBindings>
                    </TextBlock>
                </Grid>
            </Border>

            <ItemsControl ItemsSource="{Binding Complaints}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{StaticResource CardStyle}" Padding="15" Margin="0,0,0,10">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="100"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="120"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <TextBlock Grid.Column="0" Text="{Binding Time}"
                                           Foreground="{StaticResource TextSecondaryBrush}" FontSize="12"/>
                                <TextBlock Grid.Column="1" Text="{Binding User}"
                                           Foreground="{StaticResource TextPrimaryBrush}" FontSize="12"/>

                                <TextBlock Grid.Column="1" Text="{Binding Description}"
                                           Foreground="{StaticResource TextPrimaryBrush}"
                                           FontSize="13" FontWeight="SemiBold"
                                           Margin="0,20,0,0"/>

                                <TextBlock Grid.Column="2" Text="{Binding Status}"
                                           Foreground="{Binding Status, Converter={StaticResource StatusToColor}}"
                                           FontSize="12" VerticalAlignment="Center" HorizontalAlignment="Center"/>

                                <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center">
                                    <Button Content="Скрыть"
                                            Background="{StaticResource AccentPinkBrush}"
                                            Foreground="White"
                                            BorderThickness="0"
                                            Padding="15,6"
                                            Cursor="Hand"
                                            Command="{Binding DataContext.HideCommand, RelativeSource={RelativeSource AncestorType={x:Type ItemsControl}}}"
                                            CommandParameter="{Binding}"/>
                                    <Button Content="Ответить"
                                            Background="Transparent"
                                            Foreground="{StaticResource TextPrimaryBrush}"
                                            BorderBrush="#DDDDDD"
                                            BorderThickness="1"
                                            Padding="15,6"
                                            Margin="8,0,0,0"
                                            Cursor="Hand"
                                            Command="{Binding DataContext.ReplyCommand, RelativeSource={RelativeSource AncestorType={x:Type ItemsControl}}}"
                                            CommandParameter="{Binding}"/>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>
    </ScrollViewer>
</UserControl>