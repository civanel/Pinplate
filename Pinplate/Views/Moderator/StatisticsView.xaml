<UserControl x:Class="Pinplate.Views.Moderator.StatisticsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:Pinplate.ViewModels"
             xmlns:converters="clr-namespace:Pinplate.Converters"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignHeight="700" d:DesignWidth="900">

    <UserControl.DataContext>
        <vm:StatisticsViewModel/>
    </UserControl.DataContext>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel>
            <TextBlock Text="Статистика"
                       FontSize="24" FontWeight="Bold"
                       Foreground="{StaticResource TextPrimaryBrush}"
                       Margin="0,0,0,20"/>

            <!-- Фильтр + Экспорт -->
            <Border Style="{StaticResource CardStyle}" Padding="15" Margin="0,0,0,15">
                <Grid>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="Период:" VerticalAlignment="Center"
                                   Foreground="{StaticResource TextPrimaryBrush}"
                                   FontSize="13" Margin="0,0,10,0"/>
                        <ComboBox Width="130" SelectedItem="{Binding SelectedPeriod}">
                            <ComboBoxItem Content="Неделя"/>
                            <ComboBoxItem Content="Месяц"/>
                            <ComboBoxItem Content="Год"/>
                        </ComboBox>
                    </StackPanel>
                    <Button Content="Экспорт"
                            HorizontalAlignment="Right"
                            Background="{StaticResource AccentPinkBrush}"
                            Foreground="White"
                            BorderThickness="0"
                            Padding="20,6"
                            Cursor="Hand"
                            Command="{Binding ExportCommand}" Style="{StaticResource SmallButtonStyle}"/>
                </Grid>
            </Border>

            <!-- График -->
            <Border Style="{StaticResource CardStyle}" Margin="0,0,0,15">
                <StackPanel>
                    <TextBlock Text="График активности" FontWeight="Bold"
                               Foreground="{StaticResource TextPrimaryBrush}"
                               Margin="0,0,0,15"/>

                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="150"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <Canvas Grid.Row="0" ClipToBounds="False">
                            <Polyline Points="{Binding ChartPoints, Converter={StaticResource PointsConverter}}"
                                      Stroke="{StaticResource AccentPinkBrush}"
                                      StrokeThickness="2"/>
                        </Canvas>

                        <Grid Grid.Row="1" Margin="0,10,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Пн" FontSize="11"
                                       Foreground="{StaticResource TextSecondaryBrush}"
                                       HorizontalAlignment="Center"/>
                            <TextBlock Grid.Column="1" Text="Ср" FontSize="11"
                                       Foreground="{StaticResource TextSecondaryBrush}"
                                       HorizontalAlignment="Center"/>
                            <TextBlock Grid.Column="2" Text="Пт" FontSize="11"
                                       Foreground="{StaticResource TextSecondaryBrush}"
                                       HorizontalAlignment="Center"/>
                            <TextBlock Grid.Column="3" Text="Вс" FontSize="11"
                                       Foreground="{StaticResource TextSecondaryBrush}"
                                       HorizontalAlignment="Center"/>
                        </Grid>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- Топ рецептов + Топ юзеров -->
            <Grid Margin="0,0,0,15">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Style="{StaticResource CardStyle}" Margin="0,0,10,0">
                    <StackPanel>
                        <TextBlock Text="Топ-рецепты" FontWeight="Bold"
                                   Foreground="{StaticResource TextPrimaryBrush}"
                                   Margin="0,0,0,15"/>
                        <ItemsControl ItemsSource="{Binding TopRecipes}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding DisplayText}"
                                               Foreground="{StaticResource TextPrimaryBrush}"
                                               FontSize="13" Margin="0,0,0,8"/>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <Border Grid.Column="1" Style="{StaticResource CardStyle}">
                    <StackPanel>
                        <TextBlock Text="Топ-юзеры" FontWeight="Bold"
                                   Foreground="{StaticResource TextPrimaryBrush}"
                                   Margin="0,0,0,15"/>
                        <ItemsControl ItemsSource="{Binding TopUsers}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding DisplayText}"
                                               Foreground="{StaticResource TextPrimaryBrush}"
                                               FontSize="13" Margin="0,0,0,8"/>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- Активность по дням -->
            <Border Style="{StaticResource CardStyle}">
                <StackPanel>
                    <TextBlock Text="Активность по дням" FontWeight="Bold"
                               Foreground="{StaticResource TextPrimaryBrush}"
                               Margin="0,0,0,15"/>

                    <ItemsControl ItemsSource="{Binding ActivityByDay}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,0,0,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="50"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="50"/>
                                    </Grid.ColumnDefinitions>

                                    <TextBlock Grid.Column="0" Text="{Binding Day}"
                                               Foreground="{StaticResource TextPrimaryBrush}"
                                               FontSize="12" VerticalAlignment="Center"/>

                                    <Border Grid.Column="1" Height="20"
                                            Background="#EFE6E0" CornerRadius="10"
                                            VerticalAlignment="Center">
                                        <Border HorizontalAlignment="Left"
                                                Background="{StaticResource AccentPinkBrush}"
                                                CornerRadius="10"
                                                Width="{Binding Percent, Converter={StaticResource PercentToWidth}}"/>
                                    </Border>

                                    <TextBlock Grid.Column="2" Text="{Binding Value}"
                                               Foreground="{StaticResource TextSecondaryBrush}"
                                               FontSize="12" VerticalAlignment="Center"
                                               HorizontalAlignment="Right"/>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>