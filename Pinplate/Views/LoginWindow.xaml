<Window x:Class="Pinplate.Views.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Pinplate — Вход"
        Height="800" Width="1200"
        MinHeight="600" MinWidth="900"
        WindowStartupLocation="CenterScreen"
        WindowState="Maximized"
        Background="{DynamicResource BackgroundBrush}">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- ЛЕВАЯ ЧАСТЬ: брендинг -->
        <Border Grid.Column="0" Background="{StaticResource SidebarBrush}">
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                <Grid Width="140" Height="140" Margin="0,0,0,30">
                    <Ellipse Fill="{StaticResource AccentPinkBrush}"/>
                    <TextBlock Text="P" HorizontalAlignment="Center" VerticalAlignment="Center"
                               FontSize="60" FontWeight="Bold" Foreground="White"/>
                </Grid>
                <TextBlock Text="PINPLATE" FontSize="42" FontWeight="Bold"
                           Foreground="White" HorizontalAlignment="Center"/>
                <TextBlock Text="Кулинарное сообщество" FontSize="15"
                           Foreground="{StaticResource TextOnSidebarBrush}"
                           HorizontalAlignment="Center" Margin="0,10,0,0"/>
            </StackPanel>
        </Border>

        <!-- ПРАВАЯ ЧАСТЬ: форма -->
        <Grid Grid.Column="1">
            <Border Style="{StaticResource CardStyle}"
                    Width="440"
                    VerticalAlignment="Center"
                    HorizontalAlignment="Center"
                    Padding="40">
                <StackPanel>

                    <!-- Переключатель вкладок -->
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,30">
                        <Button x:Name="BtnTabLogin" Content="Вход"
                                Style="{StaticResource SmallButtonStyle}"
                                Background="{StaticResource AccentPinkBrush}"
                                Foreground="White"
                                BorderThickness="0"
                                Padding="20,8"
                                Margin="0,0,8,0"
                                Click="TabLogin_Click"/>
                        <Button x:Name="BtnTabReset" Content="Забыли пароль?"
                                Style="{StaticResource SmallButtonStyle}"
                                Padding="20,8"
                                Click="TabReset_Click"/>
                    </StackPanel>

                    <!-- ====== ВХОД ====== -->
                    <StackPanel x:Name="PanelLogin">
                        <TextBlock Text="Вход в аккаунт" FontSize="20" FontWeight="Bold"
                                   Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,20"/>

                        <TextBlock Text="Email" FontSize="13"
                                   Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,5"/>
                        <TextBox x:Name="TB_LoginEmail" Height="42" Padding="12,0"
                                 VerticalContentAlignment="Center"
                                 Background="#F5EDE8" BorderThickness="0" Margin="0,0,0,15"/>

                        <TextBlock Text="Пароль" FontSize="13"
                                   Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,5"/>
                        <Grid Margin="0,0,0,20">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <PasswordBox x:Name="PB_LoginPassword" Grid.Column="0"
                                         Height="42" Padding="12,0"
                                         VerticalContentAlignment="Center"
                                         Background="#F5EDE8" BorderThickness="0"/>
                            <TextBox x:Name="TB_LoginPasswordVisible" Grid.Column="0"
                                     Height="42" Padding="12,0"
                                     VerticalContentAlignment="Center"
                                     Background="#F5EDE8" BorderThickness="0"
                                     Visibility="Collapsed"/>
                            <Button Grid.Column="1" x:Name="BtnTogglePassword"
                                    Content="👁" Width="40" Height="42"
                                    Background="Transparent" BorderThickness="0"
                                    Cursor="Hand" Click="TogglePassword_Click"/>
                        </Grid>

                        <Button x:Name="BtnLogin" Content="ВОЙТИ" Height="46"
                                Background="{StaticResource AccentPinkBrush}"
                                Foreground="White" FontSize="14" FontWeight="SemiBold"
                                BorderThickness="0" Cursor="Hand"
                                IsDefault="True" Click="Login_Click">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border Background="{TemplateBinding Background}" CornerRadius="8">
                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>

                        <!-- Индикатор загрузки -->
                        <ProgressBar x:Name="LoginProgress" Height="4" IsIndeterminate="True"
                                     Background="Transparent" BorderThickness="0"
                                     Foreground="{StaticResource AccentPinkBrush}"
                                     Margin="0,10,0,0" Visibility="Collapsed"/>
                    </StackPanel>

                    <!-- ====== СБРОС ПАРОЛЯ ====== -->
                    <StackPanel x:Name="PanelReset" Visibility="Collapsed">
                        <TextBlock Text="Сброс пароля" FontSize="20" FontWeight="Bold"
                                   Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,10"/>
                        <TextBlock Text="Введите email, привязанный к аккаунту — мы отправим код для восстановления."
                                   FontSize="12" TextWrapping="Wrap"
                                   Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,20"/>

                        <TextBlock Text="Email" FontSize="13"
                                   Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,5"/>
                        <TextBox x:Name="TB_ResetEmail" Height="42" Padding="12,0"
                                 VerticalContentAlignment="Center"
                                 Background="#F5EDE8" BorderThickness="0" Margin="0,0,0,20"/>

                        <!-- Шаг 2: код + новый пароль (по умолчанию скрыт) -->
                        <StackPanel x:Name="PanelResetStep2" Visibility="Collapsed">
                            <TextBlock Text="Код из письма" FontSize="13"
                                       Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,5"/>
                            <TextBox x:Name="TB_ResetCode" Height="42" Padding="12,0"
                                     VerticalContentAlignment="Center"
                                     Background="#F5EDE8" BorderThickness="0" Margin="0,0,0,15"/>

                            <TextBlock Text="Новый пароль" FontSize="13"
                                       Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,5"/>
                            <PasswordBox x:Name="PB_NewPassword" Height="42" Padding="12,0"
                                         VerticalContentAlignment="Center"
                                         Background="#F5EDE8" BorderThickness="0" Margin="0,0,0,15"/>

                            <TextBlock Text="Повторите пароль" FontSize="13"
                                       Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,5"/>
                            <PasswordBox x:Name="PB_NewPasswordConfirm" Height="42" Padding="12,0"
                                         VerticalContentAlignment="Center"
                                         Background="#F5EDE8" BorderThickness="0" Margin="0,0,0,20"/>
                        </StackPanel>

                        <Button x:Name="BtnReset" Content="ОТПРАВИТЬ ССЫЛКУ" Height="46"
                                Background="{StaticResource AccentPinkBrush}"
                                Foreground="White" FontSize="14" FontWeight="SemiBold"
                                BorderThickness="0" Cursor="Hand" Click="Reset_Click">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border Background="{TemplateBinding Background}" CornerRadius="8">
                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>

                        <ProgressBar x:Name="ResetProgress" Height="4" IsIndeterminate="True"
                                     Background="Transparent" BorderThickness="0"
                                     Foreground="{StaticResource AccentPinkBrush}"
                                     Margin="0,10,0,0" Visibility="Collapsed"/>
                    </StackPanel>

                    <!-- Сообщение об ошибке / успехе -->
                    <TextBlock x:Name="MessageText" FontSize="12"
                               Foreground="{StaticResource AccentPinkBrush}"
                               TextWrapping="Wrap"
                               Margin="0,15,0,0"
                               Visibility="Collapsed"/>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Window>