<UserControl x:Class="Pinplate.Views.Users.UsersListView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:Pinplate.ViewModels"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignHeight="700" d:DesignWidth="900">

    <UserControl.DataContext>
        <vm:UsersListViewModel/>
    </UserControl.DataContext>

    <StackPanel>
        <TextBlock Text="Юзеры"
                   FontSize="24" FontWeight="Bold"
                   Foreground="{StaticResource TextPrimaryBrush}"
                   Margin="0,0,0,20"/>

        <!-- Фильтры -->
        <Border Style="{StaticResource CardStyle}" Padding="15" Margin="0,0,0,15">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Фильтр по роли -->
                <ComboBox Grid.Column="0" Width="120" Margin="0,0,10,0"
                          SelectedValue="{Binding SelectedRole}" SelectedValuePath="Content">
                    <ComboBoxItem Content="Все" IsSelected="True"/>
                    <ComboBoxItem Content="User"/>
                    <ComboBoxItem Content="Expert"/>
                    <ComboBoxItem Content="Moderator"/>
                </ComboBox>

                <!-- Сортировка -->
                <ComboBox Grid.Column="1" Width="130"
                          SelectedValue="{Binding SelectedSort}" SelectedValuePath="Content">
                    <ComboBoxItem Content="По дате" IsSelected="True"/>
                    <ComboBoxItem Content="По имени"/>
                </ComboBox>

                <TextBlock Grid.Column="3" Text="Сбросить"
                           Foreground="{StaticResource AccentPinkBrush}"
                           FontSize="12" Cursor="Hand" VerticalAlignment="Center">
                    <TextBlock.InputBindings>
                        <MouseBinding Gesture="LeftClick" Command="{Binding ResetCommand}"/>
                    </TextBlock.InputBindings>
                </TextBlock>
            </Grid>
        </Border>

        <!-- Список юзеров -->
        <ItemsControl ItemsSource="{Binding Users}">
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Border Style="{StaticResource CardStyle}" Padding="20" Margin="0,0,0,10">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <Border Grid.Column="0" Width="50" Height="50"
                                    CornerRadius="25"
                                    Background="{StaticResource AccentPinkBrush}"
                                    VerticalAlignment="Center">
                                <TextBlock Text="{Binding Initial}"
                                           Foreground="White"
                                           FontSize="20" FontWeight="Bold"
                                           VerticalAlignment="Center"
                                           HorizontalAlignment="Center"/>
                            </Border>

                            <StackPanel Grid.Column="1" Margin="15,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="{Binding Username}"
                                           FontSize="14" FontWeight="Bold"
                                           Foreground="{StaticResource TextPrimaryBrush}"/>
                                <TextBlock Text="{Binding FullName}"
                                           FontSize="12"
                                           Foreground="{StaticResource TextPrimaryBrush}"
                                           Margin="0,3,0,0"/>
                                <TextBlock Text="{Binding Info}"
                                           FontSize="11"
                                           Foreground="{StaticResource TextSecondaryBrush}"
                                           Margin="0,3,0,0"/>
                            </StackPanel>

                            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                <Button Content="Профиль"
                                        Background="Transparent"
                                        Foreground="{StaticResource TextPrimaryBrush}"
                                        BorderBrush="#DDDDDD"
                                        BorderThickness="1"
                                        Padding="15,6"
                                        Cursor="Hand"
                                        Command="{Binding DataContext.ProfileCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                        CommandParameter="{Binding}" Style="{StaticResource SmallButtonStyle}"/>
                                <Button Content="Забанить"
                                        Background="{StaticResource AccentPinkBrush}"
                                        Foreground="White"
                                        BorderThickness="0"
                                        Padding="15,6"
                                        Margin="8,0,0,0"
                                        Cursor="Hand"
                                        Command="{Binding DataContext.BanCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                        CommandParameter="{Binding}" Style="{StaticResource SmallButtonStyle}"/>
                            </StackPanel>
                        </Grid>
                    </Border>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
    </StackPanel>
</UserControl>