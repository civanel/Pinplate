<UserControl x:Class="Pinplate.Controls.TopBar"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             x:Name="Root"
             d:DesignHeight="70" d:DesignWidth="900">

    <Grid Margin="20,0">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>

        <Grid Grid.Column="0" HorizontalAlignment="Left" VerticalAlignment="Center">
            <Border Background="#EBE6E0" CornerRadius="8" Height="40" Width="300">
                <Grid>
                    <TextBlock Text="🔍" VerticalAlignment="Center" Margin="10,0" Foreground="{StaticResource TextSecondaryBrush}"/>

                    <TextBox x:Name="SearchBox" Background="Transparent" BorderThickness="0" Margin="35,0,10,0" 
                             VerticalContentAlignment="Center" TextChanged="SearchBox_TextChanged" 
                             GotFocus="SearchBox_GotFocus" LostFocus="SearchBox_LostFocus"
                             Foreground="{StaticResource TextPrimaryBrush}"/>

                    <TextBlock x:Name="SearchPlaceholder" Text="Поиск..." VerticalAlignment="Center" Margin="35,0,10,0" 
                               IsHitTestVisible="False" Foreground="{StaticResource TextSecondaryBrush}"/>
                </Grid>
            </Border>

            <Popup x:Name="HistoryPopup" PlacementTarget="{Binding ElementName=SearchBox}" Placement="Bottom" 
                   StaysOpen="False" AllowsTransparency="True" PopupAnimation="Fade">
                <Border Background="White" CornerRadius="8" Width="300" Margin="0,5,0,0" Padding="5">
                    <Border.Effect>
                        <DropShadowEffect Color="#CCC" BlurRadius="10" ShadowDepth="2" Opacity="0.5"/>
                    </Border.Effect>
                    <ItemsControl ItemsSource="{Binding DataContext.SearchHistory, RelativeSource={RelativeSource AncestorType=Window}}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Content="{Binding}" HorizontalContentAlignment="Left" 
                                        Background="Transparent" BorderThickness="0" Padding="10,8" 
                                        Cursor="Hand" Click="HistoryItem_Click"/>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Border>
            </Popup>
        </Grid>

        <Button Grid.Column="1" Content="🔔" FontSize="20" Background="Transparent" BorderThickness="0" Cursor="Hand" Margin="20,0" VerticalAlignment="Center" Click="Notification_Click" Foreground="{StaticResource TextPrimaryBrush}"/>

        <Button Grid.Column="2" Width="36" Height="36" Cursor="Hand" Click="Avatar_Click" Background="Transparent" BorderThickness="0">
            <Button.Template>
                <ControlTemplate TargetType="Button">
                    <Border Background="#D68C8C" CornerRadius="18">
                        <TextBlock Text="M" Foreground="White" FontWeight="Bold" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                    </Border>
                </ControlTemplate>
            </Button.Template>
        </Button>
    </Grid>
</UserControl>